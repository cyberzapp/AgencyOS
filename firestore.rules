rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function belongsToOrg(orgId) {
      return isSignedIn() && request.auth.token.orgId == orgId;
    }

    match /organizations/{orgId} {
      allow read, write: if belongsToOrg(orgId);

      match /deliverables/{deliverableId} {
        allow read, write: if belongsToOrg(orgId);
      }
      match /receipts/{receiptId} {
        allow read: if belongsToOrg(orgId);
        allow create: if belongsToOrg(orgId);
        allow update, delete: if false; // Cryptographic receipts are immutable
      }
    }
  }
}
