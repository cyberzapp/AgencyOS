# ==============================================================================
# AgencyOS — Firebase & Google Cloud Platform Configuration
# ==============================================================================
# Note: AgencyOS includes a heavy-duty Circuit Breaker & Resilient Fallback Engine.
# When any Firebase or GCP key is omitted or unreachable, AgencyOS automatically
# falls back to local file-backed persistence & in-memory Pub/Sub queues with
# full cryptographic SHA-256 receipts and zero downtime.

# 1. Firebase Client SDK (Authentication with Google & Firestore Realtime)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agencyos-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agencyos-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agencyos-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 2. Firebase Admin SDK (Server-side Tenant Isolation & Audit Logging)
FIREBASE_ADMIN_PROJECT_ID=agencyos-prod
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# 3. Google Cloud Platform (Pub/Sub Work Queues, Cloud Storage, Logging)
GCP_PROJECT_ID=agencyos-prod
GCP_PUBSUB_APPROVAL_TOPIC=agencyos-approval-events
GCP_PUBSUB_NOTIFICATION_TOPIC=agencyos-email-notifications
GCP_PUBSUB_SOCIAL_PUBLISH_TOPIC=agencyos-social-publishing
GCP_STORAGE_BUCKET=agencyos-deliverable-assets

# 4. Google Gemini / Vertex AI (Feedback Actionability & Autonomous Copilot)
GEMINI_API_KEY=
